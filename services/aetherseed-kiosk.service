# AetherSeed Companion - the console on the attached screen.
#
# labwc (a single-app Wayland compositor, ALREADY in the package set so it adds
# nothing to the cartridge) running one fullscreen Chromium, pointed at the
# console on 127.0.0.1:2077. No desktop, no launcher, no second window.
#
# WHY NOT CHROMIUM STRAIGHT ONTO DRM/KMS, which was the first choice: Debian's
# Chromium is not built with the drm or gbm ozone backends. Measured
# 2026-09-20 - "FATAL: Invalid ozone platform: drm" - after an earlier check
# that appeared to say they existed and was wrong, because --headless
# overrides the platform and hides the error. Only wayland and x11 are built
# in, so a compositor is required and labwc is the one already here.
#
# PAMName=login with TTYPath is what makes this work at all. A Wayland
# compositor needs a logind session on seat0 to open the VT and become DRM
# master; started from an SSH shell it fails with "Could not open target tty:
# Permission denied", which is the whole diagnosis of the first attempt.
#
# getty@tty2 is enabled alongside this. Ctrl+Alt+F2 always reaches a shell,
# whatever the kiosk is doing - a device you cannot get into when the screen
# misbehaves is not an appliance, it is a brick.
#
# NO MODAL THIS DEVICE CANNOT ANSWER. Measured 2026-09-21: the screen had been
# sitting on a gnome-keyring prompt - "Choose password for new keyring" - since
# the kiosk first started, with Chromium blank behind it and the page never
# loading. Nobody was there to type a password, and on an appliance nobody ever
# will be. A dialog waiting for a human is a hang with a face on it.
# --password-store=basic is the fix for that one; the two flags beside it close
# the same class (a crash-restore bubble after an unclean shutdown, an error
# dialog) and are prevention rather than something observed.

[Unit]
Description=AetherSeed Companion - kiosk console on tty1
Documentation=https://github.com/kommandantvold-ops/aetherseed-local
After=aetherseed-gui.service systemd-user-sessions.service
Wants=aetherseed-gui.service
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=andreas
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/1000
# drm ALONE MEANS NO KEYBOARD AND NO MOUSE. wlroots builds only the
# backends named here; without libinput the compositor has a screen and
# no input devices at all - it opens none, and logs nothing. Found on
# 2026-09-23, after the unit had shipped with it since step 18.
Environment=WLR_BACKENDS=drm,libinput
Environment=HOME=/home/andreas

# --kiosk and --app together: no tab strip, no omnibox, fullscreen that the
# browser enforces itself rather than requests. --start-fullscreen alone is a
# request, and was measured losing to a window size the browser had saved
# from an earlier run - see below.
#
# THE BROWSER KEEPS NOTHING. --user-data-dir is on /run/user/1000, which is
# tmpfs: every boot starts from an empty profile, and nothing the browser
# writes ever reaches the SD card. Three defects in one night came from state
# a previous run had left behind in the old on-disk profile:
#   - a keyring the profile had asked to create, prompting for a password
#   - the page itself, heuristically cached with no Cache-Control
#   - an app window placement saved at scale 1 (1905x2140) and restored at
#     scale 3 as three times the size of the screen, content off the right
#     edge and the composer off the bottom
# A kiosk that can be broken by its own yesterday is not a cartridge. And the
# record endpoint carries excerpts of prompts: in an on-disk profile, anything
# the browser kept would be a second copy of what people typed, outside every
# promise this node makes.
#
# --force-device-scale-factor=3 because the attached screen is a television,
# not a monitor: 3840x2160 across 1600x900 mm, which is about 72 inches, read
# from across a room rather than from arm's length. At 1:1 the console renders
# as a 317 mm ribbon down the middle of a 1600 mm screen. The right number
# depends on where the viewer actually stands and is a judgement to be made in
# front of it, not from here.
# -C: the kiosk's own config (kiosk/labwc/rc.xml says why). Without it labwc
# read /etc/xdg/labwc and started the Pi desktop behind the console.
ExecStart=/usr/bin/labwc -C /opt/aetherseed/kiosk/labwc -s "/usr/bin/chromium \
    --ozone-platform=wayland \
    --kiosk \
    --app=http://127.0.0.1:2077/ \
    --force-device-scale-factor=3 \
    --no-first-run --no-default-browser-check \
    --disable-features=Translate,AutofillServerCommunication \
    --disable-background-networking \
    --disable-component-update \
    --check-for-update-interval=31536000 \
    --disable-sync \
    --disable-breakpad \
    --password-store=basic \
    --disable-session-crashed-bubble \
    --noerrdialogs \
    --user-data-dir=/run/user/1000/aetherseed-kiosk"

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

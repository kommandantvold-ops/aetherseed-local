# AetherSeed Companion - the console.
#
# Serves the page on port 2077 and relays its API calls to the proxy on 8001.
# It never speaks to hailo-ollama on 8000: every guard - token budget,
# sanitizers, all four generation bounds, provenance - lives at the proxy's
# exit point, and a UI that went straight to the model would have none of them.
#
# Port 2077 was chosen 2026-09-18 (build log, step 13c). Until build log 54
# the bind was loopback: the console was for whoever was at the device. Since
# 54 it listens on every address, and the firewall decides who reaches it:
# loopback (the unit's own screen) and the unit's own Wi-Fi (wlan0, WPA2, the
# steward's passkey - tools/hotspot.sh), nothing else. services/nftables.conf
# is the other half of this line; neither is safe to change alone.

[Unit]
Description=AetherSeed Companion - console
Documentation=https://github.com/kommandantvold-ops/aetherseed-local
After=aetherseed-proxy.service network.target
Wants=aetherseed-proxy.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=aetherseed
Group=aetherseed
WorkingDirectory=/opt/aetherseed/gui
ExecStart=/opt/aetherseed/venv/bin/python3 /opt/aetherseed/gui/serve.py
Environment=AETHERSEED_GUI_BIND=0.0.0.0
Environment=AETHERSEED_GUI_PORT=2077
Environment=AETHERSEED_BACKEND=http://127.0.0.1:8001
Restart=always
# The one place this server may write: a shutdown request that
# aetherseed-shutdown.path turns into an orderly poweroff (gui/serve.py).
RuntimeDirectory=aetherseed-gui
RuntimeDirectoryMode=0755
RestartSec=5

# It serves fixed files and relays HTTP to loopback. It needs no device, no
# home, and nothing writable at all - not even a state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
